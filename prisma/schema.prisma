generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  CITY_ADMIN
  AREA_ADMIN
  STORE_ADMIN
  DELIVERY_PARTNER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id              String           @id @default(uuid())
  mobile          String           @unique
  email           String?          @unique
  emailVerified   Boolean          @default(false)
  role            Role             @default(CUSTOMER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  customerProfile CustomerProfile?
  addresses       CustomerAddress[]

  @@map("users")
}

model CustomerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  firstName       String
  lastName        String
  gender          Gender
  dateOfBirth     DateTime
  profileImagePath String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

// --------------------------------------------------------------------------
// Location hierarchy: State -> City -> Area.
// These are PuretyFarm's serviceable-location catalog, used for manual
// location selection and as the authoritative source of truth for saved
// addresses. Customer APIs are read-only; admin management is out of scope.
// --------------------------------------------------------------------------

model State {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
  addresses CustomerAddress[]

  @@index([isActive])
  @@map("states")
}

model City {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  areas     Area[]
  addresses CustomerAddress[]

  // A city name is unique within its state (two states may share a city name).
  @@unique([stateId, name])
  @@index([stateId])
  @@index([isActive])
  @@map("cities")
}

model Area {
  id        String   @id @default(uuid())
  name      String
  cityId    String
  pincode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]

  // An area name is unique within its city.
  @@unique([cityId, name])
  @@index([cityId])
  @@index([isActive])
  @@map("areas")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  userId       String
  fullName     String
  mobile       String
  // "houseNumber" captures room/flat/house number (required).
  houseNumber  String
  // Optional free-text components of the street address.
  buildingName String?
  streetName   String?
  landmark     String?
  // Foreign keys are the source of truth for the location hierarchy.
  stateId      String
  cityId       String
  areaId       String
  // Denormalized name snapshots resolved from the IDs at write time. Kept so a
  // later rename of a catalog entry does not silently rewrite saved addresses.
  state        String
  city         String
  area         String
  pincode      String?
  // Coordinates are only stored when supplied (GPS). Null for manual selection.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stateRef State @relation(fields: [stateId], references: [id])
  cityRef  City  @relation(fields: [cityId], references: [id])
  areaRef  Area  @relation(fields: [areaId], references: [id])

  @@index([userId])
  @@index([stateId])
  @@index([cityId])
  @@index([areaId])
  @@map("customer_addresses")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
