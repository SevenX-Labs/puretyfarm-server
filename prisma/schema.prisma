generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  CITY_ADMIN
  AREA_ADMIN
  STORE_ADMIN
  DELIVERY_PARTNER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id              String           @id @default(uuid())
  mobile          String           @unique
  email           String?          @unique
  emailVerified   Boolean          @default(false)
  role            Role             @default(CUSTOMER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  customerProfile CustomerProfile?
  addresses       CustomerAddress[]
  planQuotes      PlanQuote[]
  planSelections  PlanSelection[]
  planDeliveries  PlanDelivery[]
  changeRequests  ManageDeliveryChangeRequest[]
  orders          Order[]
  wallet          Wallet?
  payments        Payment[]
  cashCollections CashCollection[]

  @@map("users")
}

model CustomerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  firstName       String
  lastName        String
  gender          Gender
  dateOfBirth     DateTime
  profileImagePath String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

// --------------------------------------------------------------------------
// Location hierarchy: State -> City -> Area.
// These are PuretyFarm's serviceable-location catalog, used for manual
// location selection and as the authoritative source of truth for saved
// addresses. Customer APIs are read-only; admin management is out of scope.
// --------------------------------------------------------------------------

model State {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
  addresses CustomerAddress[]

  @@index([isActive])
  @@map("states")
}

model City {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  areas     Area[]
  addresses CustomerAddress[]

  // A city name is unique within its state (two states may share a city name).
  @@unique([stateId, name])
  @@index([stateId])
  @@index([isActive])
  @@map("cities")
}

model Area {
  id        String   @id @default(uuid())
  name      String
  cityId    String
  pincode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]

  // An area name is unique within its city.
  @@unique([cityId, name])
  @@index([cityId])
  @@index([isActive])
  @@map("areas")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  userId       String
  fullName     String
  mobile       String
  // "houseNumber" captures room/flat/house number (required).
  houseNumber  String
  // Optional free-text components of the street address.
  buildingName String?
  streetName   String?
  landmark     String?
  // Foreign keys are the source of truth for the location hierarchy.
  stateId      String
  cityId       String
  areaId       String
  // Denormalized name snapshots resolved from the IDs at write time. Kept so a
  // later rename of a catalog entry does not silently rewrite saved addresses.
  state        String
  city         String
  area         String
  pincode      String?
  // Coordinates are only stored when supplied (GPS). Null for manual selection.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stateRef State @relation(fields: [stateId], references: [id])
  cityRef  City  @relation(fields: [cityId], references: [id])
  areaRef  Area  @relation(fields: [areaId], references: [id])

  @@index([userId])
  @@index([stateId])
  @@index([cityId])
  @@index([areaId])
  @@map("customer_addresses")
}

model Session {
  id               String    @id @default(uuid())
  userId           String?
  adminId          String?
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin            Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
  @@map("sessions")
}

model Admin {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  changeReviews       ManageDeliveryChangeRequest[]
  walletCreditReviews WalletCreditRequest[]
  cashConfirmations   CashCollection[]

  @@index([email])
  @@index([isActive])
  @@map("admins")
}

// --------------------------------------------------------------------------
// Plan Configuration & Pricing.
// Admin-managed plan definitions with pricing. Customer APIs are read-only.
// --------------------------------------------------------------------------

enum PlanType {
  BUY_ONCE
  SEVEN_DAY_TRIAL
  MONTHLY
}

enum DeliveryFrequency {
  DAILY
  ALTERNATE_DAYS
}

enum QuantityMode {
  FIXED
  ALTERNATING
}

enum PlanQuoteStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PlanSelectionStatus {
  CONFIRMED
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Lifecycle of a single scheduled delivery within a plan selection.
enum DeliveryStatus {
  SCHEDULED
  SKIPPED
  DELIVERED
}

/// Admin-configured plan definition and pricing. One row per PlanType.
/// Prices and limits are data, never hardcoded in TypeScript.
model PlanConfig {
  id                    String   @id @default(uuid())
  planType              PlanType @unique
  isActive              Boolean  @default(true)
  /// Actual MRP price per litre, in INTEGER PAISE (shown as strikethrough).
  /// Money is stored as integer paise to avoid floating-point rounding errors.
  actualPricePerLitre   Int
  /// Selling (discounted) price per litre, in INTEGER PAISE.
  sellingPricePerLitre  Int
  /// Minimum litres per order/delivery.
  quantityMin           Int      @default(1)
  /// Maximum litres per order/delivery.
  quantityMax           Int      @default(5)
  /// BUY_ONCE: max lifetime uses. Ignored for other plan types.
  maxUsages             Int      @default(7)
  /// SEVEN_DAY_TRIAL: number of delivery days. Ignored for other plan types.
  trialDurationDays     Int      @default(7)
  /// MONTHLY: whether the DAILY delivery frequency is offered. Ignored for other plan types.
  dailyEnabled               Boolean @default(true)
  /// MONTHLY: whether the ALTERNATE_DAYS delivery frequency is offered.
  alternateDaysEnabled       Boolean @default(true)
  /// MONTHLY: whether the FIXED quantity mode is offered.
  fixedQuantityEnabled       Boolean @default(true)
  /// MONTHLY: whether the ALTERNATING quantity mode is offered.
  alternatingQuantityEnabled Boolean @default(true)
  /// Delivery fee in INTEGER PAISE, charged per order/delivery for this plan type.
  deliveryFeePaise       Int      @default(0)
  /// Delivery window start time (HH:MM, 24h). Null means not configured.
  deliveryStartTime      String?
  /// Delivery window end time (HH:MM, 24h). Null means not configured.
  deliveryEndTime        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([planType])
  @@map("plan_configs")
}

/// Immutable server-generated quote. Contains a snapshot of all calculation
/// inputs so the price cannot be tampered with between quote and confirmation.
model PlanQuote {
  id                   String          @id @default(uuid())
  userId               String
  planType             PlanType
  status               PlanQuoteStatus @default(PENDING)

  // Quantity configuration
  frequency            DeliveryFrequency?
  quantityMode         QuantityMode?
  /// For FIXED mode or BUY_ONCE/TRIAL single quantity.
  quantity             Int?
  /// For ALTERNATING mode.
  quantityA            Int?
  quantityB            Int?

  // Calculation snapshots (immutable once created). All monetary values are
  // stored as INTEGER PAISE so the snapshot is financially exact and tamper-proof.
  actualPricePerLitre  Int
  sellingPricePerLitre Int
  deliveryOccurrences  Int
  /// Whole litres (quantity is always an integer), so Int is exact.
  totalLitres          Int
  totalActualAmount    Int
  totalSellingAmount   Int
  discountAmount       Int

  // Billing period (for monthly quotes)
  billingPeriodStart   DateTime?
  billingPeriodEnd     DateTime?

  expiresAt            DateTime
  createdAt            DateTime        @default(now())

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  selections           PlanSelection[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("plan_quotes")
}

/// Tracks customer plan selections/usage. This is the source of truth for
/// eligibility calculations (trial used? buy-once count?).
model PlanSelection {
  id          String              @id @default(uuid())
  userId      String
  quoteId     String
  planType    PlanType
  status      PlanSelectionStatus @default(CONFIRMED)

  // ── Mutable delivery-schedule configuration (Manage Delivery) ──────────
  // Seeded from the immutable quote snapshot at confirmation, then editable by
  // the customer for FUTURE deliveries only. The quote stays immutable; this is
  // the live schedule config.
  frequency    DeliveryFrequency?
  quantityMode QuantityMode?
  quantity     Int?
  quantityA    Int?
  quantityB    Int?
  /// First delivery date of the current schedule window (date-only).
  startDate    DateTime?
  /// Last delivery date of the current schedule window (date-only).
  endDate      DateTime?

  // ── Payment tracking ─────────────────────────────────────────────
  /// How the plan was paid: WALLET or CASH. Null for legacy free activations.
  paymentMethod  String?
  /// When the plan was paid. Null until payment completes.
  paidAt         DateTime?
  /// The amount paid in INTEGER PAISE. Null for legacy records.
  paidAmountPaise Int?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote          PlanQuote           @relation(fields: [quoteId], references: [id])
  deliveries     PlanDelivery[]
  changeRequests ManageDeliveryChangeRequest[]
  orders         Order[]
  cashCollection CashCollection?

  @@index([userId])
  @@index([planType])
  @@index([userId, planType])
  @@index([userId, status])
  @@map("plan_selections")
}

/// One concrete scheduled delivery within a PlanSelection. Persisting each
/// delivery as its own row is what makes the Manage Delivery "future-only" rule
/// enforceable: edits touch only rows whose date is in the future, leaving
/// historical deliveries untouched. The (selectionId, deliveryDate) uniqueness
/// gives database-level protection against duplicate / racing skip records.
model PlanDelivery {
  id             String         @id @default(uuid())
  selectionId    String
  /// Denormalised owner for cheap isolation-scoped queries.
  userId         String
  /// Date-only (no time component). The delivery day.
  deliveryDate   DateTime       @db.Date
  /// 1-based occurrence index within the current schedule window. Drives the
  /// ALTERNATING pattern (odd -> A, even -> B) by occurrence, never by day.
  occurrence     Int
  quantityLitres Int
  status         DeliveryStatus @default(SCHEDULED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  selection      PlanSelection  @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order?

  @@unique([selectionId, deliveryDate])
  @@index([userId])
  @@index([selectionId])
  @@index([deliveryDate])
  @@map("plan_deliveries")
}

// --------------------------------------------------------------------------
// Manage Delivery Change Requests (admin-approval workflow).
// --------------------------------------------------------------------------

enum ChangeRequestType {
  CHANGE_QUANTITY
  CHANGE_FREQUENCY
  CHANGE_PLAN
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Records a customer-initiated delivery change that requires admin approval.
/// Preserves a snapshot of both the current and requested configuration so the
/// approval history is unambiguous even after the underlying plan mutates.
model ManageDeliveryChangeRequest {
  id                       String              @id @default(uuid())
  userId                   String
  planSelectionId          String
  requestType              ChangeRequestType
  status                   ChangeRequestStatus @default(PENDING)
  /// JSON snapshot of the configuration at the time of the request.
  currentConfiguration     Json
  /// JSON snapshot of what the customer requested.
  requestedConfiguration   Json
  adminId                  String?
  adminNote                String?
  reviewedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planSelection PlanSelection @relation(fields: [planSelectionId], references: [id], onDelete: Cascade)
  admin         Admin?        @relation(fields: [adminId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([planSelectionId])
  @@index([status])
  @@map("manage_delivery_change_requests")
}

// --------------------------------------------------------------------------
// Orders, Order Items & Invoices.
// --------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id                   String        @id @default(uuid())
  /// Human-readable, unique order number (e.g. PF10001).
  orderNumber          String        @unique
  userId               String
  planSelectionId      String?
  planDeliveryId       String?       @unique
  planType             PlanType
  status               OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(PENDING)

  // ── Financial snapshot (INTEGER PAISE) ──
  subtotalPaise        Int
  discountPaise        Int           @default(0)
  taxPaise             Int           @default(0)
  deliveryFeePaise     Int           @default(0)
  totalPaise           Int

  // ── Delivery snapshot ──
  deliveryDate         DateTime?     @db.Date
  deliveryStartTime    String?
  deliveryEndTime      String?

  // ── Address snapshot (JSON) ──
  addressSnapshot      Json

  // ── Price snapshot from PlanConfig at creation time (INTEGER PAISE) ──
  actualPricePerLitrePaise  Int?
  sellingPricePerLitrePaise Int?

  /// If this order was created from a reorder, reference the original.
  reorderedFromOrderId String?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planSelection PlanSelection? @relation(fields: [planSelectionId], references: [id])
  planDelivery  PlanDelivery?  @relation(fields: [planDeliveryId], references: [id])
  reorderedFrom Order?         @relation("Reorder", fields: [reorderedFromOrderId], references: [id])
  reorders      Order[]        @relation("Reorder")
  items         OrderItem[]
  invoice       Invoice?
  payments      Payment[]

  @@index([userId])
  @@index([userId, status])
  @@index([planSelectionId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                    String   @id @default(uuid())
  orderId               String
  /// Will reference the Product model once implemented. Nullable for now.
  productId             String?
  /// Immutable name snapshot at order time.
  productNameSnapshot   String
  quantity              Int
  /// Unit price in INTEGER PAISE.
  unitPricePaise        Int
  discountPaise         Int      @default(0)
  taxPaise              Int      @default(0)
  /// Line total in INTEGER PAISE: (unitPrice * quantity) - discount + tax.
  totalPaise            Int
  createdAt             DateTime @default(now())

  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Invoice {
  id                String   @id @default(uuid())
  /// Unique human-readable invoice number (e.g. INV-10001).
  invoiceNumber     String   @unique
  orderId           String   @unique
  /// Full financial snapshot at invoice creation time (JSON).
  financialSnapshot Json
  /// Address snapshot duplicated for invoice immutability.
  addressSnapshot   Json
  issuedAt          DateTime @default(now())

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([invoiceNumber])
  @@map("invoices")
}

// --------------------------------------------------------------------------
// Wallet, Credit Requests & Ledger Transactions.
// --------------------------------------------------------------------------

enum WalletCreditRequestStatus {
  PENDING
  COMPLETED
  REJECTED
  /// Terminal state for a credit request whose funding never arrived (PayU
  /// payment failed / was cancelled / expired, or a cash collection was
  /// cancelled). Distinct from REJECTED, which is an admin decision on money
  /// that WAS received and therefore implies a refund obligation. CANCELLED
  /// releases the one-PENDING-per-wallet slot without any refund semantics.
  CANCELLED
}

enum WalletRefundStatus {
  NOT_REQUIRED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionReferenceType {
  CREDIT_REQUEST
  ORDER
  PLAN_SELECTION
  CASH_COLLECTION
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balancePaise Int      @default(0)
  /// Whether this specific customer's wallet auto-credits a verified ONLINE
  /// top-up without admin approval. Customer-specific, never global. Default
  /// false so a brand-new customer's first credit always goes through admin
  /// approval (or cash confirmation). Flipped to true, atomically, as part of
  /// the transaction that completes that customer's first wallet credit — see
  /// `WalletService.approveCreditRequestWithin`. Never set from a request
  /// body; no customer endpoint exposes it.
  autoCreditEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditRequests    WalletCreditRequest[]
  transactions      WalletTransaction[]

  @@map("wallets")
}

model WalletCreditRequest {
  id                  String                     @id @default(uuid())
  walletId            String
  amountPaise         Int
  status              WalletCreditRequestStatus  @default(PENDING)
  refundStatus        WalletRefundStatus         @default(NOT_REQUIRED)
  autoApproved        Boolean                    @default(false)
  /// How this credit request is funded. Null for requests created directly
  /// through the Wallet API before the Payment module existed.
  source              PaymentMethod?
  idempotencyKey      String
  requestHash         String
  reviewedByAdminId   String?
  adminNote           String?
  reviewedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  wallet              Wallet                     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  reviewedByAdmin     Admin?                     @relation(fields: [reviewedByAdminId], references: [id])
  transaction         WalletTransaction?
  payments            Payment[]
  cashCollection      CashCollection?

  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@map("wallet_credit_requests")
}

model WalletTransaction {
  id                String                           @id @default(uuid())
  walletId          String
  type              WalletTransactionType
  amountPaise       Int
  balanceAfterPaise Int
  referenceType     WalletTransactionReferenceType
  referenceId       String
  creditRequestId   String?                          @unique
  description       String?
  createdAt         DateTime                         @default(now())

  wallet            Wallet                           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  creditRequest     WalletCreditRequest?             @relation(fields: [creditRequestId], references: [id])

  @@unique([type, referenceType, referenceId])
  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

// --------------------------------------------------------------------------
// Payments, PayU Transactions & Cash Collection.
//
// Responsibility split (do not blur these):
//   Payment        — verifies and records MONEY MOVEMENT.
//   CashCollection — records PHYSICAL CASH confirmation.
//   Wallet*        — owns WALLET BALANCE and the WALLET LEDGER.
//
// A Payment never mutates a wallet balance directly. It gates a
// WalletCreditRequest, and WalletService performs the only balance change.
// --------------------------------------------------------------------------

/// Payment gateway / provider. Named `PaymentProviderType` rather than
/// `PaymentProvider` so it does not collide with the `IPaymentProvider`
/// TypeScript abstraction in the payments module.
enum PaymentProviderType {
  PAYU
}

/// What the money is for. ORDER is modelled now so order checkout can be
/// added later without a migration; only WALLET_TOPUP is wired up today.
enum PaymentPurpose {
  ORDER
  WALLET_TOPUP
}

/// Lifecycle of a single payment attempt.
///
/// NOTE: the pre-existing `PaymentStatus` enum belongs to `Order.paymentStatus`
/// and has entirely different values. It is deliberately left untouched.
enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

/// How the money reaches PuretyFarm.
enum PaymentMethod {
  ONLINE
  CASH
}

enum CashCollectionStatus {
  PENDING
  COLLECTED
  CONFIRMED
  CANCELLED
}

/// One payment attempt against one provider. `transactionId` is the
/// server-generated merchant reference sent to PayU as `txnid`; it is globally
/// unique and is never supplied by a client.
model Payment {
  id                    String                   @id @default(uuid())
  userId                String
  /// Set when purpose = ORDER. Null for wallet top-ups.
  orderId               String?
  /// The credit request this payment funds. NOT uniquely constrained in Prisma:
  /// a retry after a failed attempt is a second Payment row for the same
  /// request. A partial unique index (see migration
  /// `add_payment_retry_support`) still guarantees at most ONE payment per
  /// credit request in a live or settled status, so a request can never be
  /// funded twice.
  walletCreditRequestId String?
  provider              PaymentProviderType
  purpose               PaymentPurpose
  paymentMethod         PaymentMethod            @default(ONLINE)
  /// Merchant transaction id (PayU `txnid`). Server-generated, immutable.
  transactionId         String                   @unique
  /// Provider-side id (PayU `mihpayid`). Only known after a callback/webhook.
  providerPaymentId     String?
  /// INTEGER PAISE. The authoritative amount; the client can never change it.
  amountPaise           Int
  currency              String                   @default("INR")
  status                PaymentTransactionStatus @default(PENDING)
  failureCode           String?
  failureMessage        String?
  /// Sanitised provider payload snapshot. Hashes and secrets are stripped
  /// before storage; PAYU_SALT is never written here.
  providerResponse      Json?
  /// Client-supplied Idempotency-Key header, scoped per user.
  idempotencyKey        String
  /// Fingerprint of the creation parameters. A replay with the same key but a
  /// different fingerprint is a 409, never a silent new payment.
  requestHash           String
  /// After this instant an unpaid payment may be swept to EXPIRED.
  expiresAt             DateTime?
  completedAt           DateTime?
  /// Provider refund reference (PayU `request_id` / refund mihpayid).
  providerRefundId      String?
  refundedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  order               Order?               @relation(fields: [orderId], references: [id])
  walletCreditRequest WalletCreditRequest? @relation(fields: [walletCreditRequestId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([walletCreditRequestId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([purpose, status])
  @@index([orderId])
  @@map("payments")
}

/// A physical cash top-up. The CONFIRMED transition by an admin is the
/// operational gate that proves the money actually arrived; only then is the
/// linked WalletCreditRequest allowed to credit the wallet.
model CashCollection {
  id                    String               @id @default(uuid())
  userId                String
  /// Wallet top-up purpose: one cash collection per credit request.
  walletCreditRequestId String?              @unique
  /// Plan payment purpose: one cash collection per plan selection.
  planSelectionId       String?              @unique
  /// INTEGER PAISE. Mirrors the credit request or plan quote amount.
  amountPaise           Int
  status                CashCollectionStatus @default(PENDING)
  /// When the delivery partner reported collecting the cash.
  collectedAt           DateTime?
  /// When an admin confirmed the cash was handed over and banked.
  confirmedAt           DateTime?
  confirmedByAdminId    String?
  adminNote             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletCreditRequest WalletCreditRequest? @relation(fields: [walletCreditRequestId], references: [id], onDelete: Cascade)
  planSelection       PlanSelection?       @relation(fields: [planSelectionId], references: [id], onDelete: Cascade)
  confirmedByAdmin    Admin?               @relation(fields: [confirmedByAdminId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("cash_collections")
}
